# Configurações do Banco de Dados (EXEMPLO - copie para .env)
DATABASE_URL="file:./dev.db"

# JWT (MUDE EM PRODUÇÃO!)
JWT_SECRET="sua-chave-secreta-muito-segura-aqui-mude-em-producao"
JWT_EXPIRES_IN="7d"

# CORS - origens permitidas, separadas por vírgula (obrigatório em produção)
CORS_ORIGIN="http://localhost:3000"

# Servidor
PORT=3333
HOST="0.0.0.0"

# Ambiente
NODE_ENV="development"
