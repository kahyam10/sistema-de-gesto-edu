# Configurações do Banco de Dados (EXEMPLO - copie para .env)
# Dev: Postgres do docker compose (docker compose up -d postgres)
DATABASE_URL="postgresql://postgres:SENHA@localhost:3104/gestao_edu?schema=public"

# JWT (MUDE EM PRODUÇÃO!)
JWT_SECRET="sua-chave-secreta-muito-segura-aqui-mude-em-producao"
JWT_EXPIRES_IN="7d"

# CORS - origens permitidas, separadas por vírgula (obrigatório em produção)
CORS_ORIGIN="http://localhost:3100"

# Servidor
PORT=3103
HOST="0.0.0.0"

# Ambiente
NODE_ENV="development"

# Storage de documentos da matrícula
# Driver: "local" (disco). Ponto de extensão S3/Supabase: src/storage/storage-driver.ts
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
