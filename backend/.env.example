# Configurações do Banco de Dados (EXEMPLO - copie para .env)
# Dev: Postgres do docker compose (docker compose up -d postgres)
DATABASE_URL="postgresql://postgres:SENHA@localhost:3052/gestao_edu?schema=public"

# JWT — obrigatório, mínimo 32 caracteres (gere com: openssl rand -hex 64)
JWT_SECRET=""

# Sessão web (cookies httpOnly): access token curto + refresh token rotativo
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
# Limite absoluto de uma sessão, mesmo renovando (depois disso, novo login)
SESSAO_MAX_DIAS=30

# Login: falhas por (IP + e-mail) antes do bloqueio de 15 min; teto por IP
LOGIN_MAX_FALHAS=5
LOGIN_MAX_POR_IP=60

# Nº de proxies reversos à frente da API (Coolify/Traefik = 1). Sem isso o
# rate limit vê todo mundo com o IP do proxy. Vazio = sem proxy (dev).
TRUST_PROXY=

# CORS - origens permitidas, separadas por vírgula (obrigatório em produção)
CORS_ORIGIN="http://localhost:3050"

# Servidor
PORT=3051
HOST="0.0.0.0"

# Ambiente
NODE_ENV="development"

# RH (Módulo 4): fração máxima da jornada em sala de aula. Padrão 2/3
# (Lei nº 11.738/2008, art. 2º, §4º). Aceita "2/3" ou decimal (ex.: 0.6667).
# FRACAO_MAXIMA_REGENCIA="2/3"

# Storage de documentos da matrícula
# Driver: "local" (disco). Ponto de extensão S3/Supabase: src/storage/storage-driver.ts
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
