{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // fastify 4 fica aninhado em backend/node_modules (o lock do monorepo não o
      // eleva à raiz); plugins elevados (@fastify/cookie, rate-limit) precisam
      // enxergar os MESMOS tipos para a augmentation (request.cookies etc.) valer
      "fastify": ["node_modules/fastify"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma"]
}
