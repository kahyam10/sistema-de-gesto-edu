# Copie para .env na raiz e preencha antes de rodar docker compose
# Gere segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
ACCESS_TOKEN_MINUTOS=15
# Rede/endereço do proxy à frente da API (Coolify: uniquelocal); vazio sem proxy. Número não é aceito
TRUST_PROXY=
# Origem permitida no CORS = URL pública do dashboard
CORS_ORIGIN=http://localhost:3050
# URL pela qual o NAVEGADOR acessa a API (inlined no build do dashboard)
NEXT_PUBLIC_API_URL=http://localhost:3051
# Credenciais do administrador inicial (criado pelo seed de produção)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Storage de documentos da matrícula
# Driver: "local" (disco no volume nomeado "uploads"). Ponto de extensão
# S3/Supabase: backend/src/storage/storage-driver.ts
STORAGE_DRIVER=local
# UPLOADS_DIR é fixo em /app/uploads dentro do container (definido no docker-compose.yml)
