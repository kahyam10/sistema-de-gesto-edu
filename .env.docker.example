# Copie para .env na raiz e preencha antes de rodar docker compose
# Gere segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origem permitida no CORS = URL pública do dashboard
CORS_ORIGIN=http://localhost:3001
# URL pela qual o NAVEGADOR acessa a API (inlined no build do dashboard)
NEXT_PUBLIC_API_URL=http://localhost:3333
# Credenciais do administrador inicial (criado pelo seed de produção)
ADMIN_EMAIL=
ADMIN_PASSWORD=
